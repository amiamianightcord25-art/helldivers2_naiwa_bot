QQ_APP_ID=
QQ_APP_SECRET=
QQ_SANDBOX=
# Current QQ entry point supports websocket only (also the blank default).
QQ_TRANSPORT=
# Legacy compatibility fields; no HTTP listener is started by the current entry point.
QQ_LISTEN_HOST=
QQ_LISTEN_PORT=
QQ_CALLBACK_PATH=
# Only the paired ordinary QQ private chat can use private proactive delivery.
# Empty disables private delivery; group delivery has its own data/group_push.json policy.
QQ_PUSH_USER=

HD2_PROVIDER=
HD2_COMMUNITY_BASE_URL=
HD2_CAPTURED_BASE_URL=
HD2_SUPER_CLIENT=
HD2_SUPER_CONTACT=
HD2_TIMEOUT=
HD2_RETRIES=
HD2_CACHE_TTL=
HD2_ORDER_TTL=
HD2_STATISTICS_TTL=
HD2_STATIC_TTL=
HD2_STALE_TTL=

# Optional career query service; credentials stay in this ignored private file
HD2_CAREER_CONFIG=
HD2_CAREER_TIMEOUT=
HD2_CAREER_CACHE_TTL=

# Detailed QQ queries use HTML -> JPEG; help/errors/short results stay text
HD2_IMAGE_ENABLED=
HD2_IMAGE_WIDTH=
HD2_IMAGE_QUALITY=
HD2_IMAGE_MAX_BYTES=
HD2_IMAGE_TIMEOUT=
# Use 1 on a small 2 GB server; 2 is the default on a workstation.
HD2_RENDER_CONCURRENCY=
# Optional private PNG QR; keep the actual file under ignored data/.
HD2_QR_IMAGE_PATH=
# Leave empty for bundled Chromium, or use an installed chrome/msedge channel
HD2_IMAGE_BROWSER_PATH=
HD2_IMAGE_BROWSER_CHANNEL=

# Offline equipment reference; daily background sync runs only with the QQ bot.
# Mock/CLI queries never start network synchronization.
HD2_WIKI_CATALOG_PATH=
HD2_WIKI_SYNC_ENABLED=
HD2_WIKI_SYNC_INTERVAL_HOURS=

LOG_LEVEL=
LOG_DIR=
DATABASE_PATH=
